{
  "name": "umkm-ipb-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names \"BACKEND,FRONTEND\" --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"npm run backend\" \"npm run frontend\"",
    "backend": "cd backend && powershell -Command \"while ($true) { venv312\\Scripts\\uvicorn app.main:app --reload --reload-delay 1.5 --host 0.0.0.0 --port 8000 }\"",
    "frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix frontend",
    "lint": "npm run lint --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
